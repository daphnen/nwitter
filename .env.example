# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 매직링크가 돌아올 주소. 로컬은 아래 값 그대로, 배포 후엔 Vercel 주소로.
# 비워두면 요청 헤더에서 추론하지만, 명시하는 쪽이 안전합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 웹 푸시 (채팅 알림)
# 없어도 앱은 정상 동작합니다. 설정 화면의 알림 스위치만 잠깁니다.
#
# 키 만들기:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------

# 브라우저로 나가는 공개키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 서버 전용. NEXT_PUBLIC_ 을 붙이면 누구나 이 앱 이름으로 알림을 보낼 수 있습니다.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:본인이메일@example.com

# 상대방의 구독 키를 읽으려면 RLS 우회가 필요합니다.
# Supabase → Project Settings → API → service_role. 서버 전용입니다.
SUPABASE_SERVICE_ROLE_KEY=
