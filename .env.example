# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# ── 무료 DB: Supabase ─────────────────────────────────────────────
# https://supabase.com 에서 프로젝트를 만든 뒤
# Project Settings → API 에서 값을 복사해 붙여넣으세요.
# 두 값을 비워두면 브라우저 localStorage 에 저장됩니다.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# ── 뉴스 RSS → JSON 프록시 (선택) ─────────────────────────────────
# 비워두면 무료 공개 서비스(api.rss2json.com)를 씁니다.
# REACT_APP_RSS_PROXY=https://api.rss2json.com/v1/api.json?rss_url=
